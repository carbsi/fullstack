    "lodash": "^4.17.21",
    "mongoose": "^8.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "supertest": "^7.1.4"
  }
}
