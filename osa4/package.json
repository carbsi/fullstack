{
  "name": "bloglist-backend",
  "version": "1.0.0",
  "description": "full stack open part 4 exercises",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development node --watch index.js",
    "start:test": "cross-env NODE_ENV=test SECRET=test-secret-for-bloglist node index.js",
    "start:e2e": "cross-env PORT=3004 NODE_ENV=test SECRET=test-secret-for-bloglist node index.js",
